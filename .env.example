# Falcon Deck environment variables.
# Copy this file to .env.local and fill in real values - never commit .env.local.
#
# Google Drive import (Resource Library, Phase 5) is entirely optional.
# Without these three set, Falcon Deck runs normally; the Resource Library
# just shows "Google Drive integration has not been configured for this
# installation" instead of a Connect button - nothing is faked.

# OAuth 2.0 Client ID from a Google Cloud project with the Drive API
# enabled (APIs & Services -> Credentials -> OAuth client ID -> Web
# application).
GOOGLE_DRIVE_CLIENT_ID=

# The matching OAuth client secret. Server-side only - never exposed to
# the browser, never referenced with a NEXT_PUBLIC_ prefix.
GOOGLE_DRIVE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" configured on the OAuth
# client, e.g. http://localhost:3000/api/drive/callback in development or
# https://your-deployment.example.com/api/drive/callback in production.
GOOGLE_DRIVE_REDIRECT_URI=

# Server-only secret used to encrypt and authenticate the Drive OAuth
# session cookie (AES-256-GCM) - without it, Falcon Deck treats Google
# Drive as unconfigured rather than storing tokens insecurely. Generate a
# long random value, e.g. `openssl rand -base64 32`, and never commit the
# real value or reuse it across environments.
FALCON_DECK_SESSION_SECRET=

# Supabase V2 foundation (Milestone 1 - schema/RLS/seed/repository work only;
# the live application does not read these yet, no route is gated on them,
# and no repository selection depends on them in this milestone).
#
# For local development, run `npx supabase start` and copy the printed
# "API URL", "publishable key", and "service_role key" values below.

# Public - safe to expose to the browser. The project's REST/Auth endpoint.
NEXT_PUBLIC_SUPABASE_URL=

# Public - safe to expose to the browser. Requests using this key are
# subject to Row Level Security; it grants no access on its own.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only - NEVER expose to the browser and NEVER reference with a
# NEXT_PUBLIC_ prefix. Bypasses Row Level Security entirely. Used only by
# scripts/seed-ohhs.ts and Supabase verification scripts under scripts/ -
# never imported by application code that could be bundled client-side.
SUPABASE_SERVICE_ROLE_KEY=
